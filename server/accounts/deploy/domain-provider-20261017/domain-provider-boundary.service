[Unit]
Description=DevelopED domain migration provider DB-only network boundary
Requires=docker.service developed-uid-boundary.service
After=docker.service developed-uid-boundary.service
Before=developed-auth-domain.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
RuntimeDirectory=developed-domain-provider
RuntimeDirectoryMode=0700
ExecStart=/opt/developed-runtimes/node-v24.21.0/bin/node /opt/developed-control/domain-provider/domain-provider-load-boundary.mjs --apply
ExecReload=/opt/developed-runtimes/node-v24.21.0/bin/node /opt/developed-control/domain-provider/domain-provider-load-boundary.mjs --apply
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

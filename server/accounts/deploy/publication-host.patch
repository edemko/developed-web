 # (kestrek-prod user unit). Canonical host is the apex; www and the legacy
 # kestrek.developed.sk URL redirect to it.
 http://kestrek.sk, http://test.kestrek.sk {
+    import publication_security
 	handle /.well-known/oauth-* {
 		reverse_proxy 127.0.0.1:3164
 	}

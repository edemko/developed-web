# Install as developed-auth-domain.service only after private-start authorization.
[Unit]
Description=DevelopED domain migration GoTrue (parallel auth.developed.sk issuer)
Requires=docker.service developed-uid-boundary.service domain-provider-boundary.service
After=docker.service developed-uid-boundary.service domain-provider-boundary.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/developed-runtimes/node-v24.21.0/bin/node /opt/developed-control/domain-provider/domain-provider-load-boundary.mjs --check
ExecStart=/usr/bin/docker start --attach developed-auth-domain
ExecStop=/usr/bin/docker stop --time 20 developed-auth-domain
Restart=no
TimeoutStopSec=30
UMask=0077
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/developed-domain-provider
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

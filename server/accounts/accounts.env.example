# Example only. Provision secrets outside the repository; never source this
# example against the live shared provider/database without the deployment gate.
ACCOUNTS_ORIGIN=https://www.developed.sk
ACCOUNTS_PORT=3140
ACCOUNTS_INSECURE_LOCAL=false
# Curated public-only marketing artifact; never the Git repository. Used only
# for exact / and /en/ fallback when a stale/invalid session cookie is present.
ACCOUNTS_MARKETING_DIR=/srv/www/developed

# Private, loopback-only provider control plane. Port below is a PLACEHOLDER,
# not an existing VPS mapping. Public OIDC issuer stays unchanged separately.
# HTTPS upstreams are supported; plain HTTP is allowed only on 127.0.0.1/localhost.
ACCOUNTS_PROVIDER_URL=http://127.0.0.1:39990
ACCOUNTS_PROVIDER_ADMIN_KEY=REPLACE_WITH_PRIVATE_PROVIDER_ADMIN_KEY

# The exact scoped role is mandatory. Never use postgres or a BYPASSRLS role.
ACCOUNTS_DATABASE_URL=postgresql://developed_accounts:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/postgres
# 32 random bytes, base64 encoded; back up separately from the database.
ACCOUNTS_ENCRYPTION_KEY=REPLACE_WITH_BASE64_ENCODED_32_RANDOM_BYTES

# Start with delivery disabled. Outbox messages remain encrypted and queued.
ACCOUNTS_MAIL_ENABLED=false
MAILJET_API_KEY=REPLACE_WITH_MAILJET_API_KEY
MAILJET_SECRET_KEY=REPLACE_WITH_MAILJET_SECRET
ACCOUNTS_DAILY_EMAIL_LIMIT=200
ACCOUNTS_HOURLY_REGISTRATION_LIMIT=20

# Sender noreply@developed.sk and Reply-To/support info@developed.sk are fixed
# in source. Registration defaults CLOSED in the database, independently of mail.

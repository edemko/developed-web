{
  "app": "airsoft",
  "onboarded": true,
  "auto": true,
  "node": "24.21.0",
  "repo": "/home/openclaw/Dev/airsoft-marketplace",
  "branch": "main",
  "releaseRoot": "/opt/developed-apps/airsoft/releases",
  "runtimeUser": "developed-airsoft",
  "archivePaths": [
    "app",
    "components",
    "i18n",
    "lib",
    "messages",
    "public",
    "tests",
    "vendor",
    "components.json",
    "eslint.config.mjs",
    "next.config.ts",
    "package.json",
    "package-lock.json",
    "postcss.config.mjs",
    "proxy.ts",
    "tsconfig.json"
  ],
  "migrationPaths": [
    "supabase/migrations"
  ],
  "knownSources": {
    "sms-status-102ed8b": "102ed8b87f4a92a6e2b041671d0329a76105804c"
  },
  "notes": [
    "amp.developed.sk. Template unit developed-airsoft@<release>.service, single owner of 127.0.0.1:3162; replaces the include chain developed-airsoft-sms-status -> ... -> developed-airsoft-green (2026-10-11).",
    "Migrations are applied by hand (no ledger for AMP's own migrations).",
    "Central developed-accounts changes (e.g. profile SMS) deploy separately, by hand.",
    "Public build values come from the central env file (NEXT_PUBLIC_* only). NEXT_PUBLIC_TURNSTILE_SITE_KEY is empty there (Turnstile off), so it is not passed; add it to keys once a site key is set.",
    "Next standalone output (next.config.ts output: 'standalone'), run as `node server.js` (~75 MB release, was 640 MB); sharp is traced for next/image."
  ],
  "sides": {
    "app": {
      "paths": [
        "app",
        "components",
        "i18n",
        "lib",
        "messages",
        "public",
        "vendor",
        "next.config.ts",
        "package.json",
        "package-lock.json",
        "proxy.ts"
      ],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "publicEnv": {
        "file": "/etc/developed-accounts/host-env-staging/airsoft.central.env",
        "keys": [
          "NEXT_PUBLIC_APP_URL",
          "NEXT_PUBLIC_SUPABASE_URL",
          "NEXT_PUBLIC_SUPABASE_ANON_KEY"
        ]
      },
      "steps": [
        "npm ci --no-audit --no-fund",
        "npm test",
        "npx tsc --noEmit",
        "npx next build",
        "mkdir -p .next/standalone/.next/cache"
      ],
      "artifacts": [
        {
          "from": ".next/standalone/.next",
          "to": ".next"
        },
        {
          "from": ".next/static",
          "to": ".next/static"
        },
        {
          "from": ".next/standalone/node_modules",
          "to": "node_modules"
        },
        {
          "from": ".next/standalone/server.js",
          "to": "server.js"
        },
        {
          "from": ".next/standalone/package.json",
          "to": "package.json"
        },
        {
          "from": "public",
          "to": "public"
        }
      ],
      "verify": [
        "server.js",
        ".next/BUILD_ID",
        ".next/cache",
        ".next/static",
        "node_modules/next/package.json",
        "node_modules/sharp/package.json",
        "public/developed-support.js"
      ],
      "switch": {
        "type": "instance-swap",
        "unit": "developed-airsoft@{release}.service"
      },
      "health": [
        {
          "url": "http://127.0.0.1:3162/sk",
          "status": 200
        },
        {
          "url": "http://127.0.0.1:3162/sk/listings",
          "status": 200
        },
        {
          "url": "http://127.0.0.1:3162/developed-support.js",
          "status": 200
        },
        {
          "url": "https://amp.developed.sk/sk",
          "status": 200
        }
      ]
    }
  }
}

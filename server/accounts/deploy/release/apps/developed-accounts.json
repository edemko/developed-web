{
  "app": "developed-accounts",
  "onboarded": true,
  "auto": true,
  "node": "24.21.0",
  "notes": [
    "Automatic public UI releases start from the sealed 7cf9d4100a9a central baseline; manual backend and worker reviews remain required.",
    "Routine public UI changes may auto-deploy after activation. Source, dependencies, migrations, and worker changes require a coordinated manual release.",
    "The central switch drains and re-pins the sole mail worker with the API. It refuses changed mail-worker modules or logo.",
    "Protect the release named by the live mail worker guard's RELEASE pin; it remains the worker's immutable import source after an API switch."
  ],
  "repo": "/home/openclaw/Dev/developed-web",
  "branch": "main",
  "releaseRoot": "/opt/developed-accounts/releases",
  "protect": ["502a7048ac639fe61ba8b95b0834fdaeafe0cc8b", "72e2fe9b69d5", "e51b271b962a"],
  "runtimeUser": "developed-accounts",
  "archivePaths": ["."],
  "migrationPaths": ["server/accounts/migrations"],
  "autoManualPaths": [
    "server/accounts/src", "server/accounts/package.json", "server/accounts/package-lock.json",
    "server/accounts/deploy/central-mail-worker.mjs", "server/accounts/deploy/central-mail-worker-input.mjs",
    "server/accounts/deploy/central-mail-worker-guard.mjs", "server/accounts/migrations"
  ],
  "keepReleases": 1,
  "sides": {
    "api": {
      "paths": ["server/accounts/src", "server/accounts/public", "server/accounts/package.json", "server/accounts/package-lock.json"],
      "steps": [
        "cd server/accounts",
        "npm ci --ignore-scripts --no-audit --no-fund",
        "npm test",
        "PLAYWRIGHT_MODULE=\"$PWD/node_modules/playwright/index.mjs\" node --test test/ui.browser.test.mjs",
        "npm prune --omit=dev --ignore-scripts --no-audit --no-fund"
      ],
      "artifacts": [
        { "from": "server/accounts/dist", "to": "dist" },
        { "from": "server/accounts/public", "to": "public" },
        { "from": "server/accounts/node_modules", "to": "node_modules" },
        { "from": "server/accounts/package.json", "to": "package.json" },
        { "from": "server/accounts/package-lock.json", "to": "package-lock.json" }
      ],
      "verify": ["dist/main.js", "public/index.html", "public/music-logo.png", "node_modules/pg/package.json"],
      "switch": {
        "type": "central-accounts",
        "link": "/opt/developed-accounts/current",
        "unit": "developed-accounts.service",
        "workerUnit": "developed-accounts-mail-worker.service",
        "workerDropIn": "/etc/systemd/system/developed-accounts-mail-worker.service.d/browser-family-release.conf"
      },
      "health": [
        { "url": "http://127.0.0.1:3140/health", "headers": ["Host: www.developed.sk"], "status": 200 },
        { "url": "https://www.developed.sk/login", "status": 200 }
      ]
    }
  }
}

{
  "app": "vocabulum",
  "onboarded": true,
  "auto": true,
  "repo": "/home/openclaw/Dev/vocabulary-builder",
  "branch": "main",
  "releaseRoot": "/opt/developed-apps/vocabulum/releases",
  "runtimeUser": "developed-vocabulum",
  "archivePaths": [
    "app",
    "components",
    "hooks",
    "i18n",
    "lib",
    "public",
    "types",
    "components.json",
    "eslint.config.mjs",
    "next.config.ts",
    "package.json",
    "package-lock.json",
    "postcss.config.mjs",
    "proxy.ts",
    "proxy.security.test.ts",
    "tsconfig.json",
    "vitest.config.ts"
  ],
  "migrationPaths": [
    "supabase/migrations"
  ],
  "notes": [
    "vocabulum.developed.sk. Template unit developed-vocabulum@<release>.service, single owner of 127.0.0.1:3161; replaces the per-feature units green/footer/native/showcase/favicon/word-types (2026-10-11).",
    "Migrations are applied by hand and recorded in voc_builder.schema_migrations.",
    "No NEXT_PUBLIC values: the build needs no env; runtime config comes from the central env file. The Flutter app (apps/flutter) ships separately.",
    "Next standalone output (next.config.ts output: 'standalone'): the release is the traced server (~85 MB) run as `node server.js`. It needs no @next/swc; plain `next start` without swc tries to download an SWC fallback into the read-only release and hangs (first deploy, 2026-10-11)."
  ],
  "sides": {
    "app": {
      "paths": [
        "app",
        "components",
        "hooks",
        "i18n",
        "lib",
        "public",
        "types",
        "next.config.ts",
        "package.json",
        "package-lock.json",
        "postcss.config.mjs",
        "proxy.ts"
      ],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      },
      "steps": [
        "npm ci --no-audit --no-fund",
        "npx vitest run",
        "npx tsc --noEmit",
        "npx next build",
        "mkdir -p .next/standalone/.next/cache"
      ],
      "artifacts": [
        {
          "from": ".next/standalone/.next",
          "to": ".next"
        },
        {
          "from": ".next/static",
          "to": ".next/static"
        },
        {
          "from": ".next/standalone/node_modules",
          "to": "node_modules"
        },
        {
          "from": ".next/standalone/server.js",
          "to": "server.js"
        },
        {
          "from": ".next/standalone/package.json",
          "to": "package.json"
        },
        {
          "from": "public",
          "to": "public"
        }
      ],
      "verify": [
        "server.js",
        ".next/BUILD_ID",
        ".next/cache",
        ".next/static",
        "node_modules/next/package.json",
        "public/developed-support.js"
      ],
      "switch": {
        "type": "instance-swap",
        "unit": "developed-vocabulum@{release}.service"
      },
      "health": [
        {
          "url": "http://127.0.0.1:3161/login",
          "status": 200
        },
        {
          "url": "http://127.0.0.1:3161/words",
          "status": 307
        },
        {
          "url": "http://127.0.0.1:3161/developed-support.js",
          "status": 200
        },
        {
          "url": "https://vocabulum.developed.sk/login",
          "status": 200
        }
      ]
    }
  }
}

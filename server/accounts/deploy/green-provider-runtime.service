# Install as developed-auth-green.service only after private-start authorization.
[Unit]
Description=DevelopED private green GoTrue (public SSO remains gated)
Requires=docker.service developed-uid-boundary.service green-provider-boundary.service
After=docker.service developed-uid-boundary.service green-provider-boundary.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/developed-runtimes/node-v22.23.2/bin/node /opt/developed-control/green-provider/green-provider-load-boundary.mjs --check
ExecStart=/usr/bin/docker start --attach developed-auth-green
ExecStop=/usr/bin/docker stop --time 20 developed-auth-green
Restart=no
TimeoutStopSec=30
UMask=0077
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
NoNewPrivileges=yes
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target

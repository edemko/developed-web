[Unit]
Description=DevelopED release poll — deploy apps with "auto": true when origin/main moves
Documentation=file:///home/openclaw/Dev/developed-web/server/accounts/deploy/release/README.md
ConditionPathExists=!/etc/developed-apps/developed-release-paused

[Service]
Type=oneshot
# install.sh replaces @TOOL@ with the frozen root-owned copy for one tool revision and @NODE@
# with the Node that runs the tool.
ExecStart=/usr/bin/flock -n %h/.cache/developed-release/poll.lock @NODE@ @TOOL@/developed-release.mjs poll
Nice=10
TimeoutStartSec=90min
